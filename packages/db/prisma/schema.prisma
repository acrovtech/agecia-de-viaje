generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String   @db.Text
  
  // Megamenu / Grouping
  region          String?  // e.g. "Cusco", "Lima"
  menuGroup       String?  // e.g. "Full Day", "Aventura"
  isFeatured      Boolean  @default(false)
  
  // Images
  bannerImage     String
  cardImage       String
  
  // Details
  duration        String
  altitude        String?
  transport       String?
  groupSize       String?
  difficulty      String?
  mapImage        String?  @db.Text
  
  // Pricing
  hasSharedService  Boolean  @default(true)
  sharedPrice       Float?
  hasPrivateService Boolean  @default(false)

  // SEO
  metaTitle       String?
  metaDescription String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories      Category[]
  reservations    Reservation[]

  // Relational Fields
  images          TourImage[]
  itineraries     TourItineraryDay[]
  inclusions      TourInclusion[]
  exclusions      TourExclusion[]
  recommendations TourRecommendation[]
  faqs            TourFaq[]
  privatePricing  TourPrivatePricing[]
}

model TourImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourItineraryDay {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourInclusion {
  id        String   @id @default(cuid())
  content   String
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourExclusion {
  id        String   @id @default(cuid())
  content   String
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourRecommendation {
  id        String   @id @default(cuid())
  content   String
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourPrivatePricing {
  id        String   @id @default(cuid())
  pax       Int
  price     Float
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  
  tours     Tour[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  bannerImage     String
  metaTitle       String?
  metaDescription String?  @db.Text
  keywords        String?  @db.Text
  
  paragraphs      BlogParagraph[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogParagraph {
  id       String  @id @default(cuid())
  blogId   String
  blog     Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  order    Int
  subtitle String?
  content  String  @db.Text
  image    String?
}

model Reservation {
  id               String   @id @default(cuid())
  tourId           String
  tour             Tour     @relation(fields: [tourId], references: [id])
  
  customerFirstName String
  customerLastName  String
  customerEmail    String
  customerPhone    String
  
  date             DateTime
  pax              Int
  totalPrice       Float
  
  pickupHotel      String?
  specialRequirements String?
  
  status           ReservationStatus @default(PENDING)
  paymentReference String? // Izipay transaction ID or token

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("CLIENT") // MASTER or CLIENT
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
