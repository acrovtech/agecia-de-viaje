generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String   @db.Text
  
  // Megamenu / Grouping
  region          String?  // e.g. "Cusco", "Lima"
  menuGroup       String?  // e.g. "Full Day", "Aventura"
  isFeatured      Boolean  @default(false)
  
  // Images
  bannerImage     String
  cardImage       String
  
  // Details
  duration        String
  altitude        String?
  transport       String?
  groupSize       String?
  difficulty      String?
  mapImage        String?  @db.Text
  
  // Pricing
  hasSharedService  Boolean  @default(true)
  sharedPrice       Float?
  hasPrivateService Boolean  @default(false)

  // SEO
  metaTitle       String?
  metaDescription String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories      Category[]
  reservations    Reservation[]

  // Relational Fields
  images          TourImage[]
  itineraries     TourItineraryDay[]
  inclusions      TourInclusion[]
  exclusions      TourExclusion[]
  recommendations TourRecommendation[]
  faqs            TourFaq[]
  privatePricing  TourPrivatePricing[]
}

model TourImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourItineraryDay {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourInclusion {
  id        String   @id @default(cuid())
  content   String
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourExclusion {
  id        String   @id @default(cuid())
  content   String
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourRecommendation {
  id        String   @id @default(cuid())
  content   String
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourPrivatePricing {
  id        String   @id @default(cuid())
  pax       Int
  price     Float
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  
  tours     Tour[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  bannerImage     String
  metaTitle       String?
  metaDescription String?  @db.Text
  keywords        String?  @db.Text
  
  paragraphs      BlogParagraph[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogParagraph {
  id       String  @id @default(cuid())
  blogId   String
  blog     Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  order    Int
  subtitle String?
  content  String  @db.Text
  image    String?
}

model Reservation {
  id               String   @id @default(cuid())
  tourId           String?
  tour             Tour?    @relation(fields: [tourId], references: [id])

  transferId       String?
  transfer         Transfer? @relation(fields: [transferId], references: [id])

  vehicleTypeId    String?
  vehicleType      VehicleType? @relation(fields: [vehicleTypeId], references: [id])

  serviceType      String?  // 'shared' | 'private'
  pickupTime       String?
  
  customerFirstName String
  customerLastName  String
  customerEmail    String
  customerPhone    String
  
  date             DateTime
  pax              Int
  totalPrice       Float
  
  pickupHotel      String?
  specialRequirements String? @db.Text
  
  status           ReservationStatus @default(PENDING)
  paymentReference String? // Izipay transaction ID or token

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  passengers       ReservationPassenger[]

  @@index([status])
  @@index([createdAt])
  @@index([tourId])
  @@index([transferId])
  @@index([customerEmail])
}

model ReservationPassenger {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  
  firstName     String
  lastName      String
  docType       String      @default("DNI") // DNI, Pasaporte, CE
  docNumber     String
  
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELLED
}

model Transfer {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  origin            String   // ej. "Aeropuerto de Cusco"
  destination       String   // ej. "Hotel / Centro Cusco / Est. Av Sol Inca Rail"
  duration          String   // ej. "20-30 min"
  tripType          String   @default("Solo ida") // "Solo ida", "Ida y vuelta"
  description       String?  @db.Text
  bannerImage       String?
  
  // Modalidades de servicio y precios
  hasSharedService  Boolean  @default(false)
  sharedPrice       Float?   // Precio por persona en compartido
  
  hasPrivateService Boolean  @default(true)
  
  // Tarifas privadas por vehículo
  vehiclePrices     TransferVehiclePrice[]
  reservations      Reservation[]

  isActive          Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VehicleType {
  id          String   @id @default(cuid())
  code        String   @unique // ej. "sedan", "minivan", "benz-10", "benz-15"
  name        String   // ej. "Sedan", "MiniVan", "Mercedes Benz 10pax", "Mercedes Benz 15pax"
  subtitle    String?  // ej. "Sedan / SUV", "Minivan Ejecutiva"
  maxPax      Int      // ej. 3, 6, 10, 15
  maxLuggage  Int      // ej. 3, 6, 10, 15
  image       String   // URL o path de la foto del vehículo
  features    String[] // ["Chofer profesional", "A/C en todo el recorrido", "Privado — sin compartir"]
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  prices        TransferVehiclePrice[]
  reservations  Reservation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TransferVehiclePrice {
  id          String      @id @default(cuid())
  transferId  String
  transfer    Transfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     VehicleType @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  price       Float       // Precio total por vehículo en esta ruta

  @@unique([transferId, vehicleId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("CLIENT") // MASTER or CLIENT
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

