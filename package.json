{
  "name": "agencia-de-viajes",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @repo/db generate",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:deploy": "pnpm --filter @repo/db push && pnpm --filter @repo/db seed",
    "build": "turbo run build",
    "start": "pnpm db:deploy && pnpm --filter web start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "next": "16.2.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.3",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
  }
}
