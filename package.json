{
  "name": "incabound",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @repo/db generate",
    "build": "pnpm --filter @repo/db db:push:ci && turbo run build",
    "start": "pnpm --filter web start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
