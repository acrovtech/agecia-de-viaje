# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incabound?schema=public"

# Next.js Public URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Cloudflare R2 Storage Credentials (S3 API Compatible)
R2_ACCOUNT_ID="tu_account_id_de_cloudflare"
R2_ACCESS_KEY_ID="tu_r2_access_key_id"
R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
R2_BUCKET_NAME="incabound-bucket"
R2_PUBLIC_DOMAIN="https://pub-xxxxxx.r2.dev" # O tu dominio personalizado ej: https://cdn.incabound.com

# Izipay Payment Gateway (Pasarela de Pagos Peru)
IZIPAY_PUBLIC_KEY="tu_izipay_public_key"
IZIPAY_SECRET_KEY="tu_izipay_secret_key"
IZIPAY_HMAC_SHA256="tu_izipay_hmac_key"
IZIPAY_ENDPOINT="https://api.micuentaweb.pe"
