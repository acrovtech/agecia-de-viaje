# Database Connection (PostgreSQL - docker-compose mapea al puerto host 5435)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/incabound?schema=public"

# Next.js Public URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Sesión Administrativa JWT (HS256 - Mínimo 32 caracteres)
ADMIN_SESSION_SECRET="cambiar_por_clave_criptografica_secreta_en_produccion_2026"

# Cloudflare R2 Storage Credentials (S3 API Compatible)
R2_ACCOUNT_ID="*****************"
R2_ACCESS_KEY_ID="tu_r2_access_key_id"
R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
R2_BUCKET_NAME="*********"
R2_PUBLIC_DOMAIN="********************"

# Izipay Payment Gateway (Pasarela de Pagos Perú)
# Cliente / Frontend (Browser)
NEXT_PUBLIC_IZIPAY_PUBLIC_KEY="tu_izipay_public_key"
NEXT_PUBLIC_IZIPAY_CLIENT_ENDPOINT="https://static.micuentaweb.pe"

# Servidor / Backend (API)
IZIPAY_SHOP_ID="tu_izipay_shop_id"
IZIPAY_TEST_PASSWORD="tu_izipay_test_password"
IZIPAY_HMAC_SHA256="tu_izipay_hmac_sha256_key"
IZIPAY_API_URL="https://api.micuentaweb.pe"
IZIPAY_CURRENCY="USD"

# Resend Email Service
RESEND_API_KEY="re_tu_resend_api_key"
EMAIL_FROM="reserva@incabound.com"
