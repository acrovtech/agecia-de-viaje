NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/incabound?connect_timeout=5&pool_timeout=5
API_PORT=3002
API_HOST=127.0.0.1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Explicitly publishes the entire current catalog of these agencies. Empty = no public catalog.
# Only enable after checking record ownership and intended public content.
API_PUBLIC_AGENCY_SLUGS=
API_DOCS_ENABLED=true
API_RATE_LIMIT=120
# Requires migrations and explicitly provisioned agency memberships.
API_AUTH_ENABLED=false
