{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["CATALOG_SOURCE", "API_INTERNAL_URL", "STOREFRONT_SLUG", "ADMIN_AUTH_MODE", "ADMIN_API_URL"],
      "passThroughEnv": ["DATABASE_URL"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^generate", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "API_*", "PORT", "NODE_ENV", "CATALOG_SOURCE", "STOREFRONT_SLUG", "NEXT_PUBLIC_*", "IZIPAY_*", "ADMIN_*"]
    }
  }
}
